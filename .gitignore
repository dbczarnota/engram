# Obsidian: keep config & community-plugin list, ignore volatile per-machine state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/
.trash/

# OS / editor noise
Thumbs.db
.DS_Store

# hook runtime logs (heartbeat + capture decision trace)
hooks/hook-fired.log
hooks/capture.log

# memory-loop runtime state — volatile per-machine session scratch + recall hit log
_meta/state/session-*.json
_meta/state/recall-log.jsonl
_meta/state/capture-usage.jsonl

# local per-machine Claude Code settings
.claude/settings.local.json

# Graphify code-structure graph (regenerable from code; knowledge lives in brain)
graphify-out/

# semantic search (optional) — secrets, regenerable index + uv env
_meta/semantic/.env
_meta/semantic/.index/
_meta/semantic/.venv/
_meta/semantic/__pycache__/
_meta/semantic/**/__pycache__/
_meta/semantic/.pytest_cache/
