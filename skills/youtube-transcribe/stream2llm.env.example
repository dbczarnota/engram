# stream2llm credentials for the youtube-transcribe skill.
# Copy this to  ~/.claude/stream2llm.env  (NOT into the skill dir / any repo) and fill in your key.
# The helper reads it from there; environment variables of the same name override it.

STREAM2LLM_API_KEY=str_your_key_here
STREAM2LLM_BASE_URL=https://api.stream2llm.com
